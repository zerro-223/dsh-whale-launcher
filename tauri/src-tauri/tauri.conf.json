{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH-Launcher",
  "version": "1.2.0",
  "identifier": "com.dsh.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DSH 启动器",
        "width": 940,
        "height": 750,
        "minWidth": 880,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  }
}
